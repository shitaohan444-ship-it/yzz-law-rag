NODE_ENV=development
PORT=3000
HOST=127.0.0.1

DATABASE_URL=postgresql://law_rag_user:请设置数据库密码@127.0.0.1:5432/law_rag

MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=请设置MinIO密码
MINIO_BUCKET=law-firm-files
MINIO_USE_SSL=false

# FastAPI RAG 内部地址。浏览器不得读取或直接调用该地址。
RAG_API_BASE_URL=http://127.0.0.1:8000
RAG_API_TIMEOUT_MS=120000
RAG_INGEST_TIMEOUT_MS=900000
# 当前 AUTH_ENABLED=false 时留空；启用认证后与 FastAPI 的 RAG_SERVICE_TOKEN 一致。
RAG_SERVICE_TOKEN=
# 文档地址未配置时回退 RAG_API_BASE_URL；Token 未配置时回退 RAG_SERVICE_TOKEN。
RAG_DOCUMENT_API_BASE_URL=
RAG_DOCUMENT_SERVICE_TOKEN=
# 默认 allowlist；initial_mac 仅将 force=false 的首次/普通 ingest 路由到文档服务。
RAG_DOCUMENT_ROUTE_MODE=allowlist
# 逗号或空白分隔 doc_id；为空时所有文档继续走旧 RAG。
RAG_DOCUMENT_MAC_ALLOWLIST=
