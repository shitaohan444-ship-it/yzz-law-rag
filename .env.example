# PostgreSQL
POSTGRES_DB=law_rag
POSTGRES_USER=law_rag_user
POSTGRES_PASSWORD=请设置数据库密码
POSTGRES_PORT=5432

# MinIO（业务附件与 Milvus 共用同一实例）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=请设置MinIO密码
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# RAG API
KB_API_PORT=8000
# 平台 API 只绑定本机；前端是局域网唯一入口
PLATFORM_API_PORT=3000
PLATFORM_WEB_PORT=5173
# 注意：启动 Docker 前请确保本机没有其它服务占用上述三个端口
#（例如本地 `pnpm dev`、旧 preview server 或另一个 Docker 容器），
# 否则 compose 会启动失败或返回旧网页。
APP_ENV=development
AUTH_ENABLED=false
# 生产环境设置为 true，并填入至少 32 字符的密码学随机值；不要提交真实 Token。
RAG_SERVICE_TOKEN=
# 文档路由：默认 allowlist 保持兼容；有限生产使用 initial_mac。
# legacy=全部旧RAG；allowlist=仅名单；initial_mac=仅force=false走Mac；mac=全部Mutation。
RAG_DOCUMENT_API_BASE_URL=
RAG_DOCUMENT_SERVICE_TOKEN=
RAG_DOCUMENT_ROUTE_MODE=allowlist
RAG_DOCUMENT_MAC_ALLOWLIST=
# 旧 RAG 当前保持 true；Mac 验证完成并批准切换后才在 Win11 改为 false。
RAG_DOCUMENT_MUTATIONS_ENABLED=true
# 搜索/问答官网链接开关；默认关闭，目录导入验收后再开启。
RAG_OFFICIAL_LINKS_ENABLED=false
AUTH_ADMIN_ROLE_CODES=rag_admin,system_admin,super_admin
CORS_ALLOWED_ORIGINS=
TRUSTED_HOSTS=localhost,127.0.0.1,rag-api,law-rag-kb
EXPOSE_API_DOCS=true
MAX_REQUEST_BODY_BYTES=110100480
MINIO_PRESIGNED_EXPIRES_SECONDS=300

# 多 Agent 文书 Worker（均使用至少 32 字符随机值，三处必须保持一致）
LEGAL_DRAFTING_WORKER_TOKEN=
LEGAL_DRAFTING_RUN_TOKEN_SECRET=
LEGAL_DRAFTING_RENDERER_TOKEN=
LEGAL_DRAFTING_DEV_ACTOR_ID=1
LEGAL_DRAFTING_RUN_TOKEN_TTL_SECONDS=7200
DRAFTING_LITE_GATEWAY_TIMEOUT_MS=900000
DRAFTING_LITE_MAX_VISUAL_PAGES=100
# 建议使用仅能访问 agent_runtime schema 的独立角色。
AGENT_DATABASE_URL=postgresql://law_agent_runtime:请设置独立密码@postgres:5432/law_rag?options=-c%20search_path%3Dagent_runtime%2Cpublic

# Windows Docker Desktop：填写已下载的 ModelScope 模型绝对路径
BGE_M3_HOST_PATH=C:/Users/你的用户名/.cache/modelscope/models/BAAI--bge-m3/snapshots/master
RERANKER_HOST_PATH=C:/Users/你的用户名/.cache/modelscope/models/BAAI--bge-reranker-v2-m3/snapshots/master
