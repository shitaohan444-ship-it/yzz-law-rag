# PostgreSQL
POSTGRES_DB=law_rag
POSTGRES_USER=law_rag_user
POSTGRES_PASSWORD=请设置数据库密码
POSTGRES_PORT=5432

# MinIO（业务附件与 Milvus 共用同一实例）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=请设置MinIO密码
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# RAG API
KB_API_PORT=8000
APP_ENV=development
AUTH_ENABLED=false
# 生产环境设置为 true，并填入至少 32 字符的密码学随机值；不要提交真实 Token。
RAG_SERVICE_TOKEN=
AUTH_ADMIN_ROLE_CODES=rag_admin,system_admin,super_admin
CORS_ALLOWED_ORIGINS=
TRUSTED_HOSTS=localhost,127.0.0.1,rag-api,law-rag-kb
EXPOSE_API_DOCS=true
MAX_REQUEST_BODY_BYTES=1048576
MINIO_PRESIGNED_EXPIRES_SECONDS=300

# Windows Docker Desktop：填写已下载的 ModelScope 模型绝对路径
BGE_M3_HOST_PATH=C:/Users/你的用户名/.cache/modelscope/models/BAAI--bge-m3/snapshots/master
RERANKER_HOST_PATH=C:/Users/你的用户名/.cache/modelscope/models/BAAI--bge-reranker-v2-m3/snapshots/master
