# Keep text files consistent across Windows development and Linux/Docker CI.
* text=auto

*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.py text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.ps1 text eol=crlf

# Binary project artifacts.
*.bmp binary
*.doc binary
*.docx binary
*.gif binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.png binary
*.webp binary
*.xls binary
*.xlsx binary
