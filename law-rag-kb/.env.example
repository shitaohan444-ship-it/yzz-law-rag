# =========================
# law-rag-kb 知识库 RAG 服务配置（示例）
# 复制为 .env 后按需修改；基础设施凭据与根级 docker-compose 对齐
# =========================

# 服务
KB_API_PORT=8000
APP_ENV=development
AUTH_ENABLED=false
# 生产环境必须填至少 32 字符随机值；仅上游 API Gateway 持有，浏览器不得持有。
RAG_SERVICE_TOKEN=
# true 保持兼容；Mac 验证完成并批准后，Win11 旧 RAG 才设置为 false。
RAG_DOCUMENT_MUTATIONS_ENABLED=true
# 搜索/问答补充国家法律法规数据库链接；迁移和目录验收完成前保持 false。
RAG_OFFICIAL_LINKS_ENABLED=false
AUTH_ADMIN_ROLE_CODES=rag_admin,system_admin,super_admin
CORS_ALLOWED_ORIGINS=
TRUSTED_HOSTS=localhost,127.0.0.1,testserver,rag-api,law-rag-kb
EXPOSE_API_DOCS=true
MAX_REQUEST_BODY_BYTES=110100480

# PostgreSQL（与一体化平台共用，只读 oa schema）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=law_rag
POSTGRES_USER=law_rag_user
POSTGRES_PASSWORD=law_rag_password
PG_SCHEMA=oa

# Milvus（pymilvus）
MILVUS_HOST=localhost
MILVUS_PORT=19530

# MinIO（读法律文档原件，与业务/Milvus 共用同一实例）
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=law-firm-files
MINIO_USE_SSL=false
MINIO_PRESIGNED_EXPIRES_SECONDS=300

# Embedding / Reranker（本地推理）
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
MODEL_DEVICE=cpu          # Apple Silicon 可改 mps；有 GPU 改 cuda

# 阶段 2 入库链
MILVUS_COLLECTION=kb_chunks
CHUNK_SIZE=500
CHUNK_OVERLAP=64
CHUNK_BY_ARTICLE=true     # 法规按条文边界切分；非结构文档自动回退到递归切片
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_SEQ_LEN=8192

# 图片理解（初始 Markdown → draft 切片 → 含图块 VL → 描述/OCR回填）
VL_ENABLED=true
VL_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
VL_API_KEY=请填百炼API密钥  # 可留空并复用同一百炼账号的 LLM_API_KEY
VL_MODEL=qwen3-vl-plus
VL_TIMEOUT_SECONDS=60
VL_MAX_RETRIES=3
VL_CONCURRENCY=4
VL_PROMPT_VERSION=v1
VL_FILTER_CONFIDENCE=0.90
VL_MAX_OUTPUT_TOKENS=2048
VL_NEARBY_TEXT_CHARS=800
SCAN_PAGE_MIN_TEXT_CHARS=40
PDF_RENDER_SCALE=1.5

# 阶段 3 检索链
SEARCH_TOP_K=8           # hybrid 召回候选数（dense+sparse 融合后取 N）
RERANK_TOP_K=5           # reranker 精排后返回片段数
RRF_K=60                 # RRF 融合常数（阶段 6 改 weighted 配比时不用）
HNSW_EF=64               # dense HNSW 检索 ef（≥ SEARCH_TOP_K）
RERANK_BATCH_SIZE=2      # CPU 按长度排序后小批推理，减少 padding；GPU 可单独调大
RERANK_MIN_SCORE=0.3     # 阶段6：rerank 分数低于此值的片段丢弃（保底留 top-1）；0=不过滤
HYBRID_RANKER=rrf        # 阶段6：hybrid 融合策略 rrf / weighted
DENSE_WEIGHT=0.5         # weighted 时 dense 向量权重
SPARSE_WEIGHT=0.5        # weighted 时 sparse 向量权重
SEARCH_TIMING_ENABLED=false  # true 时记录 embedding/Milvus/reranker/序列化阶段耗时

# 阶段 4 生成链
LLM_PROVIDER=stub        # stub（模板答案）/ openai（OpenAI 兼容）/ ollama
# 阿里云百炼 Qwen3.7 Plus（北京按量计费 API）示例：
# LLM_PROVIDER=openai
# LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=请填百炼API密钥
# LLM_MODEL=qwen3.7-plus
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=1200
LLM_TEMPERATURE=0.2
LLM_ENABLE_THINKING=false  # Qwen3.7 Plus：RAG 默认关闭深度思考以降低延迟/费用
CHAT_TOP_K=5             # /chat 送 LLM 的检索片段数
CHAT_MAX_CONTEXT_CHARS=4000  # prompt 片段总字符上限
# 多 Agent 法律文书工作流（Worker 通过平台内部接口领取任务）
LEGAL_DRAFTING_ENABLED=true
LEGAL_DRAFTING_WORKER_ID=legal-drafting-worker-1
LEGAL_DRAFTING_WORKER_TOKEN=
LEGAL_DRAFTING_PLATFORM_BASE_URL=http://platform-api:3000
LEGAL_DRAFTING_POLL_SECONDS=3
LEGAL_DRAFTING_LEASE_SECONDS=120
LEGAL_DRAFTING_TEMPLATE_ROOT=/templates
LEGAL_DRAFTING_OUTPUT_ROOT=/tmp/legal-drafting
AGENT_DATABASE_URL=
LEGAL_DRAFTING_PROMPT_VERSION=legal-drafting-v1
LEGAL_DRAFTING_REWRITE_LIMIT=2
LEGAL_DRAFTING_RENDERER_URL=http://document-renderer:8010
LEGAL_DRAFTING_RENDERER_TOKEN=replace-with-at-least-32-random-characters
DRAFTING_LITE_ENABLED=true
DRAFTING_LITE_DATA_ROOT=/drafting-lite
DRAFTING_LITE_RETENTION_HOURS=24
DRAFTING_LITE_MAX_VISUAL_PAGES=100
DRAFTING_LITE_MAX_TOTAL_BYTES=104857600
DRAFTING_LITE_LLM_MAX_TOKENS=4000
DRAFTING_LITE_TEMPLATE_ROOT=/templates
DRAFTING_LITE_RENDERER_URL=http://document-renderer:8010
DRAFTING_LITE_RENDERER_TOKEN=
